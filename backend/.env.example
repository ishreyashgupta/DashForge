# Backend environment variables for DashForge

# Server
PORT=5000
NODE_ENV=development

# Database
# Example (local): mongodb://127.0.0.1:27017/dashforge
# Example (Atlas): mongodb+srv://<user>:<pass>@cluster0.xxxxxx.mongodb.net/dashforge?retryWrites=true&w=majority
MONGO_URI=

# Auth
# Secret for signing JWTs
JWT_SECRET=
# Shared secret required when registering an admin account
ADMIN_SECRET=

# Mail (Mailtrap sandbox SMTP)
# Create a Mailtrap inbox and copy SMTP creds
MAILTRAP_USER=
MAILTRAP_PASS=

# The visible "from" email used in outgoing messages
EMAIL_USER=no-reply@dashforge.local

# Notes:
# - Do not commit real secrets. Copy this file to .env and fill in values.
# - Backend reads these in backend/index.js via dotenv.
# - If you add a new env var in code, update this file as documentation.
