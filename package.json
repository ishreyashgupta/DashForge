{
  "name": "my-app",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "nodemon": "^3.1.10",
    "vite": "^5.4.0"
  },
  "scripts": {
    "start": "node backend/index.js",
    "dev:server": "nodemon backend/index.js",
    "dev:client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  }
}
